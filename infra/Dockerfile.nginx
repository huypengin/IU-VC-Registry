# Multi-stage Dockerfile: build static site with Node then serve with nginx.
# This image is static-only; it does not run the Node status service.
# Live wallet-visible revocation therefore requires `/status/**` to be backed separately
# by writable runtime storage if this image is used in production.

# ---------- Stage: builder (Node) ----------         
FROM node:20-alpine AS builder

RUN apk add --no-cache libc6-compat

WORKDIR /app

ARG REGISTRY_BASE_URL
ENV REGISTRY_BASE_URL=${REGISTRY_BASE_URL}

COPY package.json package-lock.json* yarn.lock* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY tsconfig.json ./tsconfig.json
COPY tools ./tools
COPY src ./src
COPY public ./public

# Use Node's ESM loader to run ts-node for .ts entrypoints
RUN node --loader ts-node/esm ./tools/registry-cli.ts validate \
 && node --loader ts-node/esm ./tools/registry-cli.ts build

# ---------- Stage: runtime (nginx) ----------
FROM nginx:alpine AS runtime

RUN rm -f /etc/nginx/conf.d/default.conf || true

# Copy our nginx config from repo into the container
COPY infra/nginx.conf /etc/nginx/nginx.conf

# Copy only the built static output from the builder stage into nginx webroot
COPY --from=builder /app/public /usr/share/nginx/html

# Create directory for dynamic status files. This is only a mount point; without an external
# writable backing store the image still serves static build output.
RUN mkdir -p /usr/share/nginx/html/status

EXPOSE 80

# Start nginx in the foreground (docker-friendly)
CMD ["nginx", "-g", "daemon off;"]
