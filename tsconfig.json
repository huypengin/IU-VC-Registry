{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "paths": {
      "src/*": ["./src/*"],
      "src/v1.0/*": ["./src/v1.0/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "typeRoots": ["./node_modules/@types",
      "./src/types",
      "./src/v1.0/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "index.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.js",
    "**/*.d.ts",
    "**/*.map",
    "build",
    "coverage"
  ]
}
