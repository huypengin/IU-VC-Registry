# Database Configuration
DATABASE_URL=postgres://iu_did_user:iu_did_password@localhost:5432/iu_did_db

# Admin API Configuration
ADMIN_PORT=4000

# Main Server Configuration
PORT=3000
HTTPS_PORT=3443

# Public Domain Configuration
PUBLIC_DOMAIN=infra-vc-registry-web-911368042037.asia-east2.run.app

# Issuer DID Configuration
ISSUER_DID=did:web:infra-vc-registry-web-911368042037.asia-east2.run.app:issuers:principle
ISSUER_VERIFICATION_METHOD=did:web:infra-vc-registry-web-911368042037.asia-east2.run.app:issuers:principle#key-1

# ES256 / P-256 private JWK (JSON string - DO NOT COMMIT TO VERSION CONTROL)
ES256_PRIVATE_JWK_JSON='{"kty":"EC","crv":"P-256","x":"REPLACE_WITH_PUBLIC_X","y":"REPLACE_WITH_PUBLIC_Y","d":"REPLACE_WITH_PRIVATE_D","use":"sig","key_ops":["sign"],"alg":"ES256","kid":"did:web:infra-vc-registry-web-911368042037.asia-east2.run.app:issuers:principle#key-1"}'
