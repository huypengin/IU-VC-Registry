# Environment Configuration for DID Web Service

# Server Configuration
NODE_ENV=development
PORT=3000
HTTPS_PORT=3443
HOST=localhost

# SSL/TLS Configuration (paths relative to project root)
SSL_CERT_PATH=./certs/server.crt
SSL_KEY_PATH=./certs/server.key

# Ngrok Configuration
ENABLE_NGROK=true
NGROK_AUTHTOKEN=your_ngrok_auth_token_here

# DID Configuration  
DID_METHOD=web
DID_DOMAIN=your-domain.com

# Key Storage
PRIVATE_KEY_PATH=./keys/ed25519-private.pem
PUBLIC_KEY_PATH=./keys/ed25519-public.pem
