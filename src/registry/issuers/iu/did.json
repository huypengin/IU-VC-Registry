{
  "@context": [
    "https://www.w3.org/ns/did/v1",
    "https://w3id.org/security/suites/ed25519-2020/v1",
    "https://w3id.org/security/suites/secp256k1-2019/v1"
  ],
  "id": "did:web:vc.example.vn:iu",
  "alsoKnownAs": [
    "https://www.hcmiu.edu.vn/"
  ],
  "controller": "did:web:vc.example.vn:iu",

  "verificationMethod": [
    {
      "id": "did:web:vc.example.vn:iu#signing-key-1",
      "type": "Ed25519VerificationKey2020",
      "controller": "did:web:vc.example.vn:iu",
      "publicKeyMultibase": "zREPLACE_WITH_ED25519_PUBLIC_KEY"
    },
    {
      "id": "did:web:vc.example.vn:iu#eth-account-1",
      "type": "EcdsaSecp256k1RecoveryMethod2020",
      "controller": "did:web:vc.example.vn:iu",
      "ethereumAddress": "0xREPLACE_WITH_ETH_ADDRESS"
    }
  ],

  "assertionMethod": [
    "did:web:vc.example.vn:iu#signing-key-1"
  ],
  "authentication": [
    "did:web:vc.example.vn:iu#signing-key-1"
  ],

  "service": [
    {
      "id": "did:web:vc.example.vn:iu#vc-issuance",
      "type": "VerifiableCredentialIssuanceService",
      "serviceEndpoint": {
        "url": "https://vc.example.vn/api/issue",
        "description": "IU VC issuance endpoint (future use)."
      }
    },
    {
      "id": "did:web:vc.example.vn:iu#anchoring",
      "type": "AnchoringService",
      "serviceEndpoint": {
        "chainId": "eip155:11155111",
        "networkName": "sepolia",
        "contractAddress": "0xREPLACE_WITH_REGISTRY_CONTRACT",
        "description": "Ethereum anchoring contract for IU degree/transcript Merkle roots."
      }
    }
  ]
}
