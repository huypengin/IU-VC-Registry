{
  "name": "22.11-iu-did-web",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm index.ts",
    "clean": "rmdir /s /q dist",
    "docker:build": "docker build -f docker/Dockerfile -t did-web-server .",
    "docker:run": "docker-compose -f docker/docker-compose.yml up",
    "docker:stop": "docker-compose -f docker/docker-compose.yml down",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:issuer": "npm run build && node ./dist/src/registry/issuers/helper/keyGenerator.js generate",
    "generate:issuer:dev": "node --loader ts-node/esm ./src/registry/issuers/helper/keyGenerator.ts generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "multiformats": "^13.4.1",
    "ngrok": "^5.0.0-beta.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  }
}
