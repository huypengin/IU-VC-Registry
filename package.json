{
  "name": "22.11-iu-did-web",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm index.ts",
    "clean": "rmdir /s /q dist",
    "db:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-database.ps1",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:down": "node-pg-migrate down",
    "db:migrate:create": "node-pg-migrate create",
    "admin:dev": "node --loader ts-node/esm src/admin/server.ts",
    "admin:start": "npm run build && node dist/src/admin/server.js",
    "admin:test": "powershell -ExecutionPolicy Bypass -File ./scripts/test-status-api.ps1",
    "registry:dev": "node --loader ts-node/esm src/registry-server.ts",
    "registry:start": "npm run build && node dist/src/registry-server.js",
    "docker:build": "docker compose -f infra/docker-compose.yml build",
    "docker:up": "docker compose -f infra/docker-compose.yml up --build",
    "docker:up:detached": "docker compose -f infra/docker-compose.yml up --build -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "docker:start": "powershell -ExecutionPolicy Bypass -File ./scripts/docker-start.ps1",
    "docker:test": "powershell -ExecutionPolicy Bypass -File ./scripts/test-deployment.ps1",
    "postgres:up": "docker compose up postgres -d",
    "postgres:down": "docker compose down postgres",
    "postgres:logs": "docker compose logs -f postgres",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:issuer": "npm run build && node ./dist/src/registry/issuers/helper/keyGenerator.js generate",
    "generate:issuer:dev": "node --loader ts-node/esm ./src/registry/issuers/helper/keyGenerator.ts generate",
    "registry:validate": "node --loader ts-node/esm tools/registry-cli.ts validate",
    "registry:build": "node --loader ts-node/esm tools/registry-cli.ts build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/pako": "^2.0.4",
    "@types/pg": "^8.16.0",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "multiformats": "^13.4.1",
    "ngrok": "^5.0.0-beta.2",
    "node-pg-migrate": "^8.0.4",
    "pako": "^2.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  }
}
