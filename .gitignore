# .env.*.local

# SSL Certificates (keep private)
certs/*.key
certs/*.pem
certs/*.p12

# Cryptographic Keys (NEVER commit private keys)
keys/ed25519-private.pem
keys/*.key
keys/*.pem

# Application data
data/
*.db
*.sqlite

# Docker
.docker/

# IDE
.idea/
!.idea/typescript-compiler.xml
.vscode/
*.swp
*.swo
.github/*
.worktrees/

# OS
.DS_Store
Thumbs.db

 # DID / Key generation artifacts (NEVER commit private or encrypted key material)
**/es256.keys.json
**/es256.encrypted.json
# Allow sample/public templates if needed by renaming with .example
# DID documents generated per issuer (optional ignore - comment out if you want them tracked)
# **/did.json

# Explicitly never commit any generated or private key files
**/*.keys.json
**/*.encrypted.json
**/*.private.json
**/*.key.json
# Already covered but keep explicit
**/es256.keys.json
**/es256.encrypted.json

# Never commit DID private artifacts
**/*.keys
**/*.pem
**/*.key
./public/*
./.docs/*
